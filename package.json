{
  "name": "@tsci/tscircuit.ti",
  "version": "1.0.0",
  "description": "A tscircuit component package",
  "main": "index.ts",
  "module": "index.ts",
  "type": "module",
  "bin": {
    "ti": "./cli/ti.mjs"
  },
  "keywords": [
    "tscircuit",
    "circuit",
    "pcb",
    "electronics"
  ],
  "scripts": {
    "dev": "tsci dev",
    "build": "tsci build",
    "snapshot": "tsci snapshot",
    "snapshot:update": "tsci snapshot --update",
    "start": "tsci dev",
    "test": "bun test",
    "test:cli": "node --test tests/cli/*.test.mjs && bun test tests/cli/import-snapshot.test.tsx",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write",
    "format:check": "biome format .",
    "build:npm": "node scripts/build-npm-package.mjs",
    "test:npm": "node scripts/test-npm-package.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@tscircuit/core": "0.0.1787",
    "@types/bun": "^1.4.0",
    "@types/react": "^19.2.17",
    "bun-match-svg": "^0.0.17",
    "circuit-to-svg": "0.0.410",
    "tscircuit": "0.0.2460",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "author": "imrishabh18",
  "dependencies": {
    "easyeda": "0.0.360"
  }
}
