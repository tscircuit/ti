{
  "name": "@tsci/tscircuit.ti",
  "version": "1.0.0",
  "description": "A tscircuit component package",
  "main": "index.ts",
  "module": "index.ts",
  "type": "module",
  "keywords": [
    "tscircuit",
    "circuit",
    "pcb",
    "electronics"
  ],
  "scripts": {
    "dev": "tsci dev",
    "build": "tsci build",
    "snapshot": "tsci snapshot",
    "snapshot:update": "tsci snapshot --update",
    "snapshot:schematics": "tsci snapshot examples --schematic-only --disable-parts-engine --concurrency 8",
    "snapshot:schematics:update": "tsci snapshot examples --schematic-only --disable-parts-engine --update --concurrency 8",
    "start": "tsci dev",
    "typecheck": "tsc --noEmit",
    "generate:ti-sysblocks": "bun scripts/generate-ti-sysblocks-exports.ts",
    "validate:ti-sysblocks": "bun scripts/validate-ti-sysblocks-catalog.ts",
    "validate:ti-reference-examples": "bun scripts/validate-ti-reference-examples.ts",
    "format": "biome format --write",
    "format:check": "biome format ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/react": "^19.2.17",
    "tscircuit": "^0.0.2359",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "author": "imrishabh18"
}
